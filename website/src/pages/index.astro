---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

const repo = 'https://github.com/alissonjr/dev-metrics';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = 'https://alissonjr.github.io';
const url = `${origin}${base}/`;
const ogImage = `${origin}${base}/og-image.png`;
const ogDescription =
  'Métricas de engenharia self-hosted. Coleta GitLab e Jira para PostgreSQL e visualiza em Grafana, via Docker Compose.';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>dev-metrics - métricas de engenharia self-hosted</title>
    <meta
      name="description"
      content="Plataforma self-hosted de métricas de engenharia. Coleta GitLab + Jira para PostgreSQL e visualiza em Grafana. Roda 100% via Docker Compose."
    />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content="dev-metrics - métricas de engenharia self-hosted" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="dev-metrics - métricas de engenharia self-hosted" />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href={`${base}/`} class="brand">dev-metrics</a>
        <nav class="links">
          <a href={`${base}/getting-started/`}>Docs</a>
          <a href={`${base}/dashboards/gitlab/`}>Dashboards</a>
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Open source · MIT</p>
        <h1>
          Métricas de engenharia,<br />
          <span class="accent">self-hosted</span>.
        </h1>
        <p class="lede">
          Coleta GitLab e Jira para PostgreSQL, visualiza em Grafana. DORA,
          cycle time, throughput, code review. Roda 100% via Docker Compose,
          sem dependência paga.
        </p>
        <div class="cta">
          <a href={`${base}/getting-started/`} class="btn primary">Início rápido</a>
          <a href={`${base}/dashboards/gitlab/`} class="btn ghost">Ver dashboards</a>
          <a href={repo} class="btn ghost" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
        </div>
      </section>

      <section class="block">
        <p class="kicker">QUICK START</p>
        <div class="code">
          <button class="copy" type="button" aria-label="Copiar comandos">Copiar</button>
          <pre><code><span class="muted"># clona, configura, sobe</span>
git clone https://github.com/alissonjr/dev-metrics.git
cd dev-metrics
cp .env.example .env  <span class="muted"># preenche tokens GitLab e/ou Jira</span>
make up               <span class="muted"># http://localhost:3000</span></code></pre>
        </div>
      </section>

      <section class="features">
        <div>
          <p class="num">01</p>
          <h3>DORA & cycle time</h3>
          <p>Deploy frequency, lead time, MR cycle time, taxa de sucesso de pipeline. Por projeto e ambiente.</p>
        </div>
        <div>
          <p class="num">02</p>
          <h3>Kanban & sprint</h3>
          <p>Lead, cycle, action e awaiting time por issue do Jira. Throughput, WIP e burndown.</p>
        </div>
        <div>
          <p class="num">03</p>
          <h3>100% local</h3>
          <p>PostgreSQL, Grafana e 2 coletores Python sobem com um <code>make up</code>. Seus dados nunca saem da sua infra.</p>
        </div>
      </section>

      <section class="block">
        <p class="kicker">ARQUITETURA</p>
        <img
          class="diagram"
          src={`${base}/etl-diagram.svg`}
          alt="Pipeline ETL: GitLab e Jira passam pelo coletor Python (extract, transform, load) até o PostgreSQL e o Grafana"
          loading="lazy"
        />
        <p class="diagram-cta">
          <a href={`${base}/arquitetura/`}>System design e processo de sync <span>↗</span></a>
        </p>
      </section>

      <section class="stack">
        <p class="kicker dim">STACK</p>
        <ul class="logos">
          <li>
            <img src={`${base}/logos/python.svg`} alt="Python" width="24" height="24" loading="lazy" />
            <span>Python <span class="ver">3.12</span></span>
          </li>
          <li>
            <img src={`${base}/logos/postgresql.svg`} alt="PostgreSQL" width="24" height="24" loading="lazy" />
            <span>PostgreSQL <span class="ver">16</span></span>
          </li>
          <li>
            <img src={`${base}/logos/grafana.svg`} alt="Grafana" width="24" height="24" loading="lazy" />
            <span>Grafana <span class="ver">12</span></span>
          </li>
          <li>
            <img src={`${base}/logos/docker.svg`} alt="Docker" width="24" height="24" loading="lazy" />
            <span>Docker Compose <span class="ver">v2</span></span>
          </li>
        </ul>
      </section>

      <footer>
        <p>MIT · 2026 Alisson Junior</p>
        <a href={repo} class="mono" target="_blank" rel="noopener noreferrer">github.com/alissonjr/dev-metrics</a>
      </footer>
    </main>

    <script>
      document.querySelectorAll('.code .copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.parentElement?.querySelector('code');
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code.innerText.trim());
            const prev = btn.textContent;
            btn.textContent = 'Copiado';
            btn.classList.add('ok');
            setTimeout(() => {
              btn.textContent = prev;
              btn.classList.remove('ok');
            }, 1600);
          } catch {}
        });
      });
    </script>

    <style is:global>
      :root {
        --bg: #09090b;
        --fg: #f4f4f5;
        --muted: #a1a1aa;
        --dim: #71717a;
        --line: #18181b;
        --line-2: #27272a;
        --accent: #34d399;
        --accent-hi: #6ee7b7;
        --code-bg: #18181b;
        font-family: 'Inter Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      a { color: inherit; text-decoration: none; }
      code, pre { font-family: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

      .nav { border-bottom: 1px solid var(--line); }
      .nav-inner {
        max-width: 64rem;
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.875rem; font-weight: 600; letter-spacing: -0.01em; }
      .links { display: flex; gap: 1.5rem; font-size: 0.875rem; color: var(--muted); }
      .links a:hover { color: var(--fg); }

      main { max-width: 48rem; margin: 0 auto; padding: 6rem 1.5rem 8rem; }

      .hero { display: flex; flex-direction: column; gap: 1.5rem; }
      .eyebrow { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.75rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin: 0; }
      .hero h1 { font-size: clamp(2.5rem, 6vw, 3.75rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; margin: 0; }
      .accent { color: var(--accent); }
      .lede { font-size: 1.125rem; color: var(--muted); max-width: 40rem; line-height: 1.6; margin: 0; }
      .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.5rem; }
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        border-radius: 0.25rem;
        transition: background-color 150ms, border-color 150ms, color 150ms;
      }
      .btn.primary { background: var(--accent); color: var(--bg); font-weight: 500; }
      .btn.primary:hover { background: var(--accent-hi); }
      .btn.ghost { border: 1px solid #3f3f46; }
      .btn.ghost:hover { border-color: #71717a; }
      .btn.ghost span { margin-left: 0.5rem; color: var(--dim); }

      .block { margin-top: 5rem; }
      .kicker { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.75rem; color: var(--dim); margin: 0 0 0.75rem; }
      .kicker.dim { color: var(--dim); }
      pre {
        background: var(--code-bg);
        border: 1px solid var(--line-2);
        border-radius: 0.375rem;
        padding: 1.25rem;
        font-size: 0.875rem;
        line-height: 1.6;
        overflow-x: auto;
        margin: 0;
      }
      .muted { color: var(--dim); }

      .code { position: relative; }
      .code .copy {
        position: absolute;
        top: 0.625rem;
        right: 0.625rem;
        padding: 0.25rem 0.625rem;
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 0.6875rem;
        color: var(--muted);
        background: var(--line);
        border: 1px solid var(--line-2);
        border-radius: 0.25rem;
        cursor: pointer;
        transition: color 150ms, border-color 150ms;
      }
      .code .copy:hover { color: var(--fg); border-color: #3f3f46; }
      .code .copy.ok { color: var(--accent); border-color: var(--accent); }

      .features {
        margin-top: 6rem;
        display: grid;
        grid-template-columns: 1fr;
        column-gap: 2rem;
        row-gap: 2.5rem;
      }
      @media (min-width: 768px) { .features { grid-template-columns: repeat(3, 1fr); } }
      .features > div { display: flex; flex-direction: column; gap: 0.5rem; }
      .num { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.75rem; color: var(--accent); margin: 0; }
      .features h3 { font-size: 1rem; font-weight: 600; margin: 0; }
      .features p { font-size: 0.875rem; color: var(--muted); line-height: 1.6; margin: 0; }
      .features code { font-size: 0.75rem; }

      .diagram {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--line-2);
        border-radius: 0.375rem;
        background: var(--code-bg);
      }
      .diagram-cta { margin: 0.75rem 0 0; font-size: 0.875rem; }
      .diagram-cta a { color: var(--accent); }
      .diagram-cta a:hover { color: var(--accent-hi); }
      .diagram-cta span { color: var(--dim); }

      .stack { margin-top: 6rem; }
      .logos {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 2.5rem;
      }
      .logos li { display: flex; align-items: center; gap: 0.625rem; }
      /* logos monocromáticos (preto) -> invertidos para branco e atenuados = tom de cinza */
      .logos img {
        width: 1.5rem;
        height: 1.5rem;
        filter: invert(1);
        opacity: 0.5;
        transition: opacity 150ms;
      }
      .logos li:hover img { opacity: 0.9; }
      .logos span { font-size: 0.8125rem; color: var(--muted); }
      .logos .ver { color: var(--muted); margin-left: 0.15rem; }

      footer {
        margin-top: 6rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
        font-size: 0.875rem;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }
      footer p { margin: 0; }
      footer a:hover { color: #d4d4d8; }
      .mono { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.75rem; }
    </style>
  </body>
</html>
